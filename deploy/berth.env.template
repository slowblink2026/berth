# Berth environment — copy to /etc/berth.env and fill in the values.
# Permissions: chmod 600 /etc/berth.env

# ── API key ───────────────────────────────────────────────────────────────────
# Protects the /api/task endpoint. Set a strong random secret.
# If left empty, only requests from 127.0.0.1 are allowed.
BERTH_API_KEY=

# ── Domain ────────────────────────────────────────────────────────────────────
# The public hostname Caddy will serve. Caddy fetches a Let's Encrypt cert for
# this name automatically. Must resolve to this server's IP before you start.
BERTH_DOMAIN=berth.example.com

# ── Assistant (pick one block) ────────────────────────────────────────────────

# Option A: xAI (default)
XAI_API_KEY=xai-...

# Option B: Ollama running on the same VPS
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b

# Option C: Any OpenAI-compatible server
# LLM_BASE_URL=http://127.0.0.1:8088/v1
# LLM_MODEL=local
# LLM_API_KEY=local

# ── Browser ───────────────────────────────────────────────────────────────────
# Set by setup.sh; override only if you moved the browser directory.
# PLAYWRIGHT_BROWSERS_PATH=/path/to/berth/.local/pw-browsers

# ── Speed and limits (all optional) ───────────────────────────────────────────
# A task always answers within this many milliseconds, with what it has found.
# Keep it below your caller's own timeout. Default 150000.
# BERTH_TASK_DEADLINE_MS=150000
# Sites kept open at once. Each is a Chrome profile (~300 MB). Default 3.
# BERTH_MAX_CHROME=3
# Video, fonts and trackers are not loaded during tasks; images too when the model
# is not shown screenshots (LLM_VISION=0). Set 0 to load everything.
# BERTH_LITE=1
# Run Chrome headless (no Xvfb needed). Headed is harder for sites to tell from a person.
# BERTH_HEADLESS=1
# Use an installed Chrome/Chromium instead of the bundled one.
# BERTH_CHROME_PATH=/usr/bin/google-chrome
